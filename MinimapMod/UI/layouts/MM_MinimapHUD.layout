<!-- MM_MinimapHUD.layout
     Arma Reforger / Enfusion UI layout for the circular minimap HUD element.

     Widget tree overview
     ════════════════════
     Root (OverlayWidget – full-screen transparent canvas)
       └─ MinimapFrame (FrameWidget – positioned at bottom-centre, 200×200 px)
            ├─ MinimapMap    (ImageWidget – terrain/satellite texture, larger than
            │                 the frame so rotation stays filled; UV rect is set
            │                 per-frame by MM_MinimapDisplay to show the region
            │                 around the player)
            ├─ MinimapMask   (ImageWidget – circular alpha mask, rendered ABOVE
            │                 the map so pixels outside the circle are hidden;
            │                 must reference a white circle on transparent bg)
            ├─ PlayerMarker  (ImageWidget – arrow sprite centred in the circle,
            │                 always pointing up while the map rotates)
            ├─ MinimapBorder (ImageWidget – decorative circular border ring,
            │                 rendered last / on top)
            └─ CoordText     (TextWidget – small grid-coordinate label below
                              the circle, e.g. "045-082")

     IMPORTANT
     ─────────
     This file is a human-readable XML reference.  Arma Reforger uses a
     binary layout format generated by the Workbench Layout Editor.  You must
     import this XML into the Workbench and save it as a proper .layout binary
     before the engine will load it.  See README.md § "Building in Workbench".

     Widget properties reference
     ───────────────────────────
     Alignment / anchoring uses Enfusion's normalised (0–1) parent-relative
     position + pixel offset system:
       HAlign / VAlign     : "Left" | "Center" | "Right" | "Top" | "Bottom"
       PositionX/Y         : normalised offset from the parent's top-left
       OffsetX/Y           : additional pixel offset (positive = down/right)
       SizeX/Y             : pixel size (absolute, not normalised)
       ZOrder              : draw order within siblings (higher = on top)
-->

<BaseWidget
	class       = "OverlayWidget"
	Name        = "Root"
	SizeX       = "1"
	SizeY       = "1"
	HAlign      = "Left"
	VAlign      = "Top"
>
	<!-- ── Outer container ─────────────────────────────────────────────────── -->
	<!--
	    Positioned 20 px above the bottom edge, horizontally centred.
	    Clips its children so the circular mask is effective.
	-->
	<BaseWidget
		class       = "FrameWidget"
		Name        = "MinimapFrame"
		HAlign      = "Center"
		VAlign      = "Bottom"
		PositionX   = "0.5"
		PositionY   = "1.0"
		OffsetX     = "-100"
		OffsetY     = "-220"
		SizeX       = "200"
		SizeY       = "200"
		Visible     = "0"
	>
		<!-- ── Terrain / satellite map image ──────────────────────────────── -->
		<!--
		    Larger than the frame (300×300) so that rotating the texture
		    never exposes empty corners.  MM_MinimapDisplay updates the UV
		    rect every tick to keep the player at the centre.
		    Source texture: set to the world's satellite image resource,
		    e.g. "{GUID}worlds/Everon/data/everon_sat.edds"
		    If left empty the widget will be invisible until the script sets
		    the texture at runtime via ImageWidget.LoadImageTexture().
		-->
		<BaseWidget
			class       = "ImageWidget"
			Name        = "MinimapMap"
			HAlign      = "Center"
			VAlign      = "Center"
			PositionX   = "0.5"
			PositionY   = "0.5"
			OffsetX     = "-150"
			OffsetY     = "-150"
			SizeX       = "300"
			SizeY       = "300"
			ZOrder      = "0"
			Color       = "FFFFFFFF"
			KeepAspect  = "0"
		/>

		<!-- ── Circular alpha mask ────────────────────────────────────────── -->
		<!--
		    White circle on a transparent background (circle_mask.edds).
		    Set BlendMode to Multiply or use the engine's mask feature so
		    only the circular area of MinimapMap is visible.
		    Alternatively supply a "frame" image that is transparent in the
		    centre and opaque around the edges – that visually clips the map.
		    Source: "UI/textures/minimap_mask.edds"
		-->
		<BaseWidget
			class       = "ImageWidget"
			Name        = "MinimapMask"
			HAlign      = "Center"
			VAlign      = "Center"
			PositionX   = "0.5"
			PositionY   = "0.5"
			OffsetX     = "-100"
			OffsetY     = "-100"
			SizeX       = "200"
			SizeY       = "200"
			ZOrder      = "1"
			Color       = "FF000000"
		/>

		<!-- ── Player direction marker ────────────────────────────────────── -->
		<!--
		    Small arrow sprite centred in the circle.  The map texture rotates
		    behind it; the arrow stays pointing up, so "up = player forward".
		    Source: "UI/textures/player_arrow.edds"
		-->
		<BaseWidget
			class       = "ImageWidget"
			Name        = "PlayerMarker"
			HAlign      = "Center"
			VAlign      = "Center"
			PositionX   = "0.5"
			PositionY   = "0.5"
			OffsetX     = "-8"
			OffsetY     = "-8"
			SizeX       = "16"
			SizeY       = "16"
			ZOrder      = "2"
			Color       = "FFFFFFFF"
		/>

		<!-- ── Decorative circular border ─────────────────────────────────── -->
		<!--
		    A ring/border PNG drawn over the top of everything.
		    Source: "UI/textures/minimap_border.edds"
		-->
		<BaseWidget
			class       = "ImageWidget"
			Name        = "MinimapBorder"
			HAlign      = "Center"
			VAlign      = "Center"
			PositionX   = "0.5"
			PositionY   = "0.5"
			OffsetX     = "-105"
			OffsetY     = "-105"
			SizeX       = "210"
			SizeY       = "210"
			ZOrder      = "3"
			Color       = "FFFFFFFF"
		/>

	</BaseWidget><!-- MinimapFrame -->

	<!-- ── Grid coordinate label ──────────────────────────────────────────── -->
	<!--
	    Placed just below the minimap circle.  Text is updated by
	    MM_MinimapDisplay.RefreshCoordinates() every tick.
	-->
	<BaseWidget
		class       = "TextWidget"
		Name        = "CoordText"
		HAlign      = "Center"
		VAlign      = "Bottom"
		PositionX   = "0.5"
		PositionY   = "1.0"
		OffsetX     = "-30"
		OffsetY     = "-10"
		SizeX       = "60"
		SizeY       = "14"
		ZOrder      = "4"
		Color       = "FFFFFFFF"
		Text        = ""
		FontSize    = "11"
		HTextAlign  = "Center"
		VTextAlign  = "Center"
	/>

</BaseWidget><!-- Root -->
